{
  "name": "quilin-agent",
  "private": true,
  "packageManager": "pnpm@10.8.1",
  "scripts": {
    "dev": "LOG_LEVEL=debug QUILIN_ENV=dev QUILIN_RUNTIME_MODE=repl bun --env-file=.env --watch packages/agent-core/src/index.ts",
    "quilin": "bun packages/agent-core/src/index.ts",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@quilin/agent-core": "workspace:*",
    "vitest": "^4.1.4"
  }
}
