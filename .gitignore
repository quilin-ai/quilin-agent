# === Local Playwright MCP debug artifacts ===
.playwright-mcp/
*.png

# === Local Claude harness state ===
.claude/scheduled_tasks.json

# === Cross-review worktrees ===
# `.claude/worktrees/agent-<hash>/` 是 cross-review 流程生成的本地 git
# worktree（subagent 在隔离副本上工作）。worktree 内容不入仓库，否则
# 会产生大量重复的项目副本。完成 cross-review 后通过 `git worktree
# remove` 清理。
.claude/worktrees/

# === Next.js stable build artifact (apps/web/.next-stable-3008/) ===
# next.config.ts redirects `distDir` to .next-stable-3008/ when
# QUILIN_STABLE_BUILD=1 so the mac-app stable backend (3008) doesn't
# fight over .next/ with concurrent `pnpm dev`. Build output, never
# committed.
.next-stable-3008/

# === Playwright a11y snapshot debug artifacts ===
# Files produced by `mcp__playwright__browser_snapshot` capture or
# similar inspectors. Debug-only, never committed.
snapshot-stream-*.yml

# === Local user data dir ===
.local/

# === Cursor IDE 误写到工作区根目录的 Electron bundle ===
# Cursor IDE 偶尔会把自己的 Electron bundle 文件（带 hash 后缀的
# webpack/esbuild 产物）吐到用户工作区根目录，例如：
#   app-session-<hash>.js
#   main-<hash>.js
#   workspace-root-drop-handler-<hash>.js
# 这是 Cursor 的 bug 或某个 extension 的副作用，跟本项目无关。
# 仅限根目录匹配（前导 /），不影响 apps/web/ 等子目录正常的 main.js。
/app-session-*.js
/main-*.js
/workspace-root-drop-handler-*.js
