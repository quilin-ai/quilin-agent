		"@types/proper-lockfile": "^4.1.4",
		"@xyflow/react": "^12.10.2",
		"ai": "^6.0.182",
		"better-sqlite3": "^12.9.0",
		"next": "^15.0.0",
		"proper-lockfile": "^4.1.2",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"streamdown": "^1.4.0",
		"undici": "^8.2.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.12",
		"@playwright/test": "^1.49.0",
