{
  "ignorePatterns": [
    { "pattern": "^https?://localhost" },
    { "pattern": "^https?://127\\.0\\.0\\.1" },
    { "pattern": "^https?://example\\.com" },
    { "pattern": "^https?://.*\\.internal" },
    { "pattern": "^mailto:" },
    { "pattern": "^upstreams/" },
    { "pattern": "^#" },
    { "pattern": "^/Users/" },
    { "pattern": "^https?://zhuanlan\\.zhihu\\.com" },
    { "pattern": "^https?://openai\\.com/index/" }
  ],
  "replacementPatterns": [
    {
      "pattern": "^/",
      "replacement": "{{BASEURL}}/"
    }
  ],
  "httpHeaders": [
    {
      "urls": ["https://github.com/", "https://api.github.com/"],
      "headers": { "User-Agent": "quilin-agent-link-check" }
    }
  ],
  "retryOn429": true,
  "retryCount": 3,
  "fallbackRetryDelay": "30s",
  "aliveStatusCodes": [200, 203, 206, 301, 302, 307, 308, 429]
}
