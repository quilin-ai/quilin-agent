# ===== LLM Provider =====
# Phase 0 开发使用 DeepSeek
DEEPSEEK_API_KEY=sk-xxx
# Legacy fixed base-model override only; tier routing uses OMNI_LLM_TIERS_*.
# 旧固定 base model 覆盖项；三档路由请使用 OMNI_LLM_TIERS_*。
# QUILIN_DEFAULT_MODEL=deepseek-v4-pro

# Optional env overrides for the local ~/.quilin/config.toml model tiers.
# 本地 ~/.quilin/config.toml 三层模型路由也可用环境变量覆盖。
# OMNI_LLM_ROUTING_MODE=auto
# OMNI_LLM_TIERS_FLASH_MODEL=deepseek-v4-flash
# OMNI_LLM_TIERS_FLASH_THINKING=disabled
# OMNI_LLM_TIERS_LITE_MODEL=deepseek-v4-flash
# OMNI_LLM_TIERS_LITE_THINKING=enabled
# OMNI_LLM_TIERS_PRO_MODEL=deepseek-v4-pro
# OMNI_LLM_TIERS_PRO_THINKING=enabled

# 可选：其他 provider（后续启用）
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ===== 环境 =====
QUILIN_ENV=dev          # dev | test | prod
LOG_LEVEL=debug         # debug | info | warn | error
QUILIN_PORT=3000

# ===== 记忆 =====
# Optional override. Default: ~/.quilin/memory.db
# OMNIMEM_DB_PATH=
OMNIMEM_EMBEDDING_MODEL=all-MiniLM-L6-v2

# ===== Self-Evolution Optimizer Judge LM =====
# 评委 LM 与 Agent 主 LM 解耦（方便用不同模型评估 Agent）。
# Decoupled from the Agent's main LM so a different model can judge.
# Required when running `scripts/bench-real-dspy.py --mode llm`:
#   QUILIN_OPTIMIZER_JUDGE_API_KEY=<your_key>
#   QUILIN_OPTIMIZER_JUDGE_MODEL=deepseek/deepseek-chat   # LiteLLM model id
#   QUILIN_OPTIMIZER_JUDGE_BASE_URL=                       # optional, only for non-native providers
# Mode is forced to "dummy" by default; the bench script flips it to "llm"
# when `--mode llm --confirm-real-llm-cost` is passed.
# QUILIN_OPTIMIZER_JUDGE_API_KEY=
# QUILIN_OPTIMIZER_JUDGE_MODEL=deepseek/deepseek-chat
# QUILIN_OPTIMIZER_JUDGE_MODE=dummy
