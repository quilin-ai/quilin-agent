{
  "name": "@quilin/benchmarks",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bunx tsc -p tsconfig.json --noEmit",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest --configLoader runner",
    "lint": "bunx @biomejs/biome check src scripts vitest.config.ts",
    "format": "bunx @biomejs/biome format --write src scripts vitest.config.ts"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  }
}
