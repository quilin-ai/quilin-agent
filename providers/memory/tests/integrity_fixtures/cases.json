{
  "schema_version": 1,
  "cases": [
    {
      "id": "wrong-profile-profession",
      "description": "LLM writes doctor even though the evidence only supports programmer.",
      "expected_failure_type": "profile_contradiction",
      "expected_decision": "reject",
      "remediation": "Require source quote overlap before profile writes.",
      "evidence": [
        {
          "id": "turn-001",
          "actor": "user",
          "text": "我是程序员，主要写 Python 和 TypeScript。"
        }
      ],
      "candidate": {
        "id": "mem-001",
        "content": "用户是医生。",
        "kind": "profile",
        "actor": "llm_observer",
        "source_event_ids": ["turn-001"],
        "source_quote": "我是程序员"
      }
    },
    {
      "id": "observation-vs-participation",
      "description": "Mentioned Python should rank lower than doing a Python project together.",
      "expected_decision": "accept_with_lower_weight",
      "expected_failure_type": "weak_participation_signal",
      "remediation": "Store actor participation level and down-rank observed mentions.",
      "evidence": [
        {
          "id": "turn-002",
          "actor": "assistant",
          "text": "我看到孟哥提到 Python。",
          "participation": "observed_mention"
        },
        {
          "id": "turn-003",
          "actor": "user",
          "text": "我们一起做这个 Python 项目吧。",
          "participation": "collaborated_project"
        }
      ],
      "candidate": {
        "id": "mem-002",
        "content": "孟哥可能关注 Python。",
        "kind": "preference",
        "actor": "llm_observer",
        "source_event_ids": ["turn-002"],
        "source_quote": "提到 Python"
      }
    },
    {
      "id": "actor-provenance",
      "description": "Manual user, LLM observer, and import sources must be distinguishable.",
      "expected_decision": "accept",
      "expected_failure_type": "none",
      "remediation": "Preserve actor_scope on every memory row.",
      "evidence": [
        {"id": "turn-004", "actor": "user", "text": "请记住我喜欢简洁回答。"},
        {"id": "turn-005", "actor": "llm_observer", "text": "Observed concise-answer preference."},
        {"id": "import-001", "actor": "imported_claude", "text": "CLAUDE.md: user prefers concise replies."}
      ],
      "candidate": {
        "id": "mem-003",
        "content": "用户喜欢简洁回答。",
        "kind": "preference",
        "actor": "user_manual",
        "source_event_ids": ["turn-004"],
        "source_quote": "喜欢简洁回答"
      }
    },
    {
      "id": "concurrent-write-conflict",
      "description": "Two clients edit the same base version with divergent content.",
      "expected_decision": "quarantine",
      "expected_failure_type": "concurrent_write_conflict",
      "remediation": "Require compare-and-swap or merge review for same base_version writes.",
      "base_record": {
        "id": "mem-004",
        "version": 7,
        "content": "用户偏好中文摘要。"
      },
      "writes": [
        {
          "client_id": "cli",
          "base_version": 7,
          "content": "用户偏好中文摘要和短回复。"
        },
        {
          "client_id": "web",
          "base_version": 7,
          "content": "用户偏好英文详细解释。"
        }
      ]
    },
    {
      "id": "supersession-name",
      "description": "Lao Meng should be superseded by Meng-ge for preferred address.",
      "expected_decision": "supersede",
      "expected_failure_type": "superseded_fact",
      "remediation": "Link old identity memory to the newer preferred-address memory.",
      "old_record": {
        "id": "mem-005-old",
        "content": "用户的名字是老孟。",
        "predicate": "preferred_address",
        "created_at": "2026-05-01T00:00:00+00:00"
      },
      "new_record": {
        "id": "mem-005-new",
        "content": "用户希望被称呼为孟哥而不是老孟。",
        "predicate": "preferred_address",
        "created_at": "2026-05-20T00:00:00+00:00"
      }
    },
    {
      "id": "rollback-delete-recover",
      "description": "Deleted memory with a recovery receipt should be recoverable.",
      "expected_decision": "recoverable",
      "expected_failure_type": "deleted_memory_recoverable",
      "remediation": "Use soft-delete TTL and recovery receipts before permanent deletion.",
      "record": {
        "id": "mem-006",
        "content": "用户偏好先给结论。",
        "deleted": true,
        "delete_receipt_id": "del-006",
        "recovery_ref": "archive://memory/mem-006"
      }
    },
    {
      "id": "poisoning-dangerous-command",
      "description": "Seed memory tells the agent to prefer destructive shell commands.",
      "expected_decision": "reject",
      "expected_failure_type": "poisoning_dangerous_instruction",
      "remediation": "Quarantine memories that encode destructive command preferences.",
